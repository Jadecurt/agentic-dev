{
  "name": "agentic-dev-orchestrator",
  "version": "1.0.0",
  "description": "Autonomous multi-service software engineering orchestrator using Gemini and isolated Git worktrees",
  "main": "dist/cli/index.js",
  "bin": {
    "agentic-dev": "dist/cli/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:web": "npm --prefix web run build",
    "build:all": "npm run build && npm run build:web",
    "start": "tsx src/cli/index.ts",
    "dev": "tsx watch src/cli/index.ts",
    "serve": "tsx src/cli/index.ts serve",
    "test": "vitest run"
  },
  "keywords": [
    "agentic",
    "gemini",
    "git-worktrees",
    "orchestrator",
    "multi-agent",
    "monorepo"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^8.1.1",
    "@fastify/websocket": "^11.0.2",
    "@google/genai": "^2.30.0",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "ora": "^8.2.0",
    "ws": "^8.18.0",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/ws": "^8.5.14",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
