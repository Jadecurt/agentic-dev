# Google Gemini API Key (leave empty or omit to run in simulation mode)
GEMINI_API_KEY=

# Gemini Models
GEMINI_PLANNER_MODEL=gemini-2.5-pro
GEMINI_DEV_MODEL=gemini-2.5-pro
GEMINI_TESTER_MODEL=gemini-2.5-flash

# Pod & Execution Limits
MAX_POD_ITERATIONS=4
MAX_CONCURRENT_PODS=4
COMMAND_TIMEOUT_MS=60000
AUTO_APPROVE_PLAN=false

# Server Configuration
PORT=4200
HOST=127.0.0.1
